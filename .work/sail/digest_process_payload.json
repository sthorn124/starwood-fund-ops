{"processVariables": [{"name": "digest", "type": "Map"}, {"name": "sentTo", "type": "Text", "multiple": true}, {"name": "outcome", "type": "Text"}], "nodes": [{"id": 1, "type": "core.0", "name": "Start", "coordinates": [40, 200], "connections": [{"targetNodeId": 3, "activityChained": false}]}, {"id": 3, "type": "internal.16", "name": "Build the digest (rules)", "coordinates": [160, 200], "connections": [{"targetNodeId": 4, "activityChained": false}], "data": {"customOutputs": [{"expression": "rule!SD_buildChaseDigestEmail(rows: null)", "saveInto": "pv!digest"}]}, "assignment": {"attended": false, "runAs": "DESIGNER"}}, {"id": 4, "type": "core.4", "name": "Anything to chase?", "coordinates": [290, 200], "connections": [{"targetNodeId": 5, "activityChained": false}, {"targetNodeId": 7, "activityChained": false}], "decision": {"conditions": [{"expression": "=a!defaultValue(index(pv!digest, \"count\", 0), 0) > 0", "targetNodeId": 5, "label": "yes"}], "defaultPath": 7}}, {"id": 5, "type": "internal3.sendemail3", "name": "Send the digest to the draw approval team", "coordinates": [420, 120], "connections": [{"targetNodeId": 6, "activityChained": false}], "data": {"inputs": [{"name": "From", "value": "Custom Sender"}, {"name": "FromEmailValue", "expression": "=toemailaddress(cons!SD_EMAIL_REPLY_ADDRESS)"}, {"name": "Email Sender Display Name", "expression": "=tostring(cons!SD_EMAIL_SENDER_NAME)"}, {"name": "To", "expression": "=cons!SD_DRAW_DEMO_APPROVERS_GROUP"}, {"name": "Subject", "expression": "=tostring(index(pv!digest, \"subject\", \"\"))"}, {"name": "Priority", "value": 3}, {"name": "IsHTML", "value": 1}, {"name": "BodyHTML", "expression": "=tostring(index(pv!digest, \"html\", \"\"))"}], "outputs": [{"name": "ToValidAddresses", "saveInto": "pv!sentTo"}]}, "assignment": {"attended": false, "runAs": "DESIGNER"}}, {"id": 6, "type": "internal.16", "name": "Sent", "coordinates": [550, 120], "connections": [{"targetNodeId": 2, "activityChained": false}], "data": {"customOutputs": [{"expression": "\"SENT: \" & index(pv!digest, \"count\", 0) & \" draws to the group \" & tostring(group(cons!SD_DRAW_DEMO_APPROVERS_GROUP, \"groupName\")) & \" (Send E-Mail lists no ToValidAddresses for a group recipient)\"", "saveInto": "pv!outcome"}]}, "assignment": {"attended": false, "runAs": "DESIGNER"}}, {"id": 7, "type": "internal.16", "name": "Nothing to chase", "coordinates": [420, 300], "connections": [{"targetNodeId": 2, "activityChained": false}], "data": {"customOutputs": [{"expression": "\"NOTHING TO CHASE: no email sent\"", "saveInto": "pv!outcome"}]}, "assignment": {"attended": false, "runAs": "DESIGNER"}}, {"id": 2, "type": "core.1", "name": "End", "coordinates": [700, 200]}]}