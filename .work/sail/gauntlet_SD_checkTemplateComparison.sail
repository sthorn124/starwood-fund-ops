  D_doubled: a!localVariables(local!r: rule!SD_checkTemplateComparison(response: "OVERVIEW|The budget table in the new file is laid out differently from the last template that loaded, so its figures cannot be matched to the right columns and budget lines of the draw. The sender should restore the standard layout and resend the file." & char(10) & "CHANGE|COLUMN_RENAMED|Current Draw|Draw Funding This Period|The ""Current Draw"" column is now headed ""Draw Funding This Period""." & char(10) & "CHANGE|COLUMN_REMOVED|Total PTD inc. This Draw (%)||The ""Total PTD inc. This Draw (%)"" column has been removed." & char(10) & "CHANGE|ROW_REMOVED|Insurance||The ""Insurance"" budget line is missing." & char(10) & "CHANGE|ROW_REMOVED|Start-up/Marketing||The ""Start-up/Marketing"" budget line is missing." & char(10) & "CHANGE|ROW_REMOVED|Insurance||The ""Insurance"" budget line is missing.", success: true, errorMessage: null, aiAttempted: true, diff: local!diff, baselineLabel: "X"), a!map(ok: local!r.ok, aiUsed: local!r.aiUsed, failures: local!r.failures)),
  E_extraQuote: a!localVariables(local!r: rule!SD_checkTemplateComparison(response: "OVERVIEW|The budget table in the new file is laid out differently from the last template that loaded, so its figures cannot be matched to the right columns and budget lines of the draw. The sender should restore the standard layout and resend the file." & char(10) & "CHANGE|COLUMN_RENAMED|Current Draw|Draw Funding This Period|The ""Current Draw"" column is now headed ""Draw Funding This Period""." & char(10) & "CHANGE|COLUMN_REMOVED|Total PTD inc. This Draw (%)||The ""Total PTD inc. This Draw (%)"" column has been removed." & char(10) & "CHANGE|ROW_REMOVED|Insurance||The ""Insurance"" line is missing, next to ""Taxes""." & char(10) & "CHANGE|ROW_REMOVED|Start-up/Marketing||The ""Start-up/Marketing"" budget line is missing.", success: true, errorMessage: null, aiAttempted: true, diff: local!diff, baselineLabel: "X"), a!map(ok: local!r.ok, aiUsed: local!r.aiUsed, failures: local!r.failures)),
  F_overviewQuote: a!localVariables(local!r: rule!SD_checkTemplateComparison(response: "OVERVIEW|The ""Current Draw"" column changed." & char(10) & "CHANGE|COLUMN_RENAMED|Current Draw|Draw Funding This Period|The ""Current Draw"" column is now headed ""Draw Funding This Period""." & char(10) & "CHANGE|COLUMN_REMOVED|Total PTD inc. This Draw (%)||The ""Total PTD inc. This Draw (%)"" column has been removed." & char(10) & "CHANGE|ROW_REMOVED|Insurance||The ""Insurance"" budget line is missing." & char(10) & "CHANGE|ROW_REMOVED|Start-up/Marketing||The ""Start-up/Marketing"" budget line is missing.", success: true, errorMessage: null, aiAttempted: true, diff: local!diff, baselineLabel: "X"), a!map(ok: local!r.ok, aiUsed: local!r.aiUsed, failures: local!r.failures)),
  G_json: a!localVariables(local!r: rule!SD_checkTemplateComparison(response: "```json" & char(10) & "{""changes"": []}" & char(10) & "```", success: true, errorMessage: null, aiAttempted: true, diff: local!diff, baselineLabel: "X"), a!map(ok: local!r.ok, aiUsed: local!r.aiUsed, failures: local!r.failures)),
  I_curly: a!localVariables(local!r: rule!SD_checkTemplateComparison(response: "OVERVIEW|The budget table in the new file is laid out differently from the last template that loaded, so its figures cannot be matched to the right columns and budget lines of the draw. The sender should restore the standard layout and resend the file." & char(10) & "CHANGE|COLUMN_RENAMED|Current Draw|Draw Funding This Period|The “Current Draw” column is now headed “Draw Funding This Period”." & char(10) & "CHANGE|COLUMN_REMOVED|Total PTD inc. This Draw (%)||The ""Total PTD inc. This Draw (%)"" column has been removed." & char(10) & "CHANGE|ROW_REMOVED|Insurance||The ""Insurance"" budget line is missing." & char(10) & "CHANGE|ROW_REMOVED|Start-up/Marketing||The ""Start-up/Marketing"" budget line is missing.", success: true, errorMessage: null, aiAttempted: true, diff: local!diff, baselineLabel: "X"), a!map(ok: local!r.ok, aiUsed: local!r.aiUsed, failures: local!r.failures)),
  J_wrongPair: a!localVariables(local!r: rule!SD_checkTemplateComparison(response: "OVERVIEW|The budget table in the new file is laid out differently from the last template that loaded, so its figures cannot be matched to the right columns and budget lines of the draw. The sender should restore the standard layout and resend the file." & char(10) & "CHANGE|COLUMN_RENAMED|Total PTD inc. This Draw (%)|Draw Funding This Period|The ""Total PTD inc. This Draw (%)"" column is now headed ""Draw Funding This Period""." & char(10) & "CHANGE|COLUMN_REMOVED|Current Draw||The ""Current Draw"" column has been removed." & char(10) & "CHANGE|ROW_REMOVED|Insurance||The ""Insurance"" budget line is missing." & char(10) & "CHANGE|ROW_REMOVED|Start-up/Marketing||The ""Start-up/Marketing"" budget line is missing.", success: true, errorMessage: null, aiAttempted: true, diff: local!diff, baselineLabel: "X"), a!map(ok: local!r.ok, aiUsed: local!r.aiUsed, failures: local!r.failures)),
  K_pipeInSentence: a!localVariables(local!r: rule!SD_checkTemplateComparison(response: "OVERVIEW|The budget table in the new file is laid out differently from the last template that loaded, so its figures cannot be matched to the right columns and budget lines of the draw. The sender should restore the standard layout and resend the file." & char(10) & "CHANGE|COLUMN_RENAMED|Current Draw|Draw Funding This Period|The ""Current Draw"" column is now headed ""Draw Funding This Period""." & char(10) & "CHANGE|COLUMN_REMOVED|Total PTD inc. This Draw (%)||The ""Total PTD inc. This Draw (%)"" column has been removed." & char(10) & "CHANGE|ROW_REMOVED|Insurance||The ""Insurance"" budget line is missing." & char(10) & "CHANGE|ROW_REMOVED|Start-up/Marketing||The ""Start-up/Marketing"" line | is missing.", success: true, errorMessage: null, aiAttempted: true, diff: local!diff, baselineLabel: "X"), a!map(ok: local!r.ok, aiUsed: local!r.aiUsed, failures: local!r.failures)),
  M_overviewCounts_live1: a!localVariables(local!r: rule!SD_checkTemplateComparison(response: "OVERVIEW|The new file is missing several columns and budget lines that the system expects to find in a standard draw budget workbook. Two columns have been removed or renamed and one has been removed entirely, and two budget category rows are also missing, which prevents the loader from matching and processing the draw data correctly." & char(10) & "CHANGE|COLUMN_RENAMED|Current Draw|Draw Funding This Period|The ""Current Draw"" column is now headed ""Draw Funding This Period""." & char(10) & "CHANGE|COLUMN_REMOVED|Total PTD inc. This Draw (%)||The ""Total PTD inc. This Draw (%)"" column has been removed." & char(10) & "CHANGE|ROW_REMOVED|Insurance||The ""Insurance"" budget line is missing." & char(10) & "CHANGE|ROW_REMOVED|Start-up/Marketing||The ""Start-up/Marketing"" budget line is missing.", success: true, errorMessage: null, aiAttempted: true, diff: local!diff, baselineLabel: "X"), a!map(ok: local!r.ok, aiUsed: local!r.aiUsed, failures: local!r.failures)),
  N_overviewDigit: a!localVariables(local!r: rule!SD_checkTemplateComparison(response: "OVERVIEW|The new file has 3 layout changes, so it cannot be matched to the draw." & char(10) & "CHANGE|COLUMN_RENAMED|Current Draw|Draw Funding This Period|The ""Current Draw"" column is now headed ""Draw Funding This Period""." & char(10) & "CHANGE|COLUMN_REMOVED|Total PTD inc. This Draw (%)||The ""Total PTD inc. This Draw (%)"" column has been removed." & char(10) & "CHANGE|ROW_REMOVED|Insurance||The ""Insurance"" budget line is missing." & char(10) & "CHANGE|ROW_REMOVED|Start-up/Marketing||The ""Start-up/Marketing"" budget line is missing.", success: true, errorMessage: null, aiAttempted: true, diff: local!diff, baselineLabel: "X"), a!map(ok: local!r.ok, aiUsed: local!r.aiUsed, failures: local!r.failures)),
