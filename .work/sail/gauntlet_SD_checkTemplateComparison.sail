/* Regression gauntlet for SD_checkTemplateComparison (Phase 5, 2026-09-25). Paste into a throwaway zz rule and testRule it.
   Expected: A_good and I_curly ok (aiUsed true). Change-line failures (aiUsed false, rules text): B_invented, C_missed,
   D_doubled, E_extraQuote, G_json, H_notSuccess, J_wrongPair, K_pipeInSentence. Overview-only failures (ok false,
   aiUsed true: the AI lines kept under standard summary wording): F_overviewQuote, M_overviewCounts_live1 (first live
   answer), N_overviewDigit, O_overviewRestates_live2 (second live answer), P_overviewWrongPart (names the header fields, which did not change). L_skipped_noDiff composes the rules text. */
a!localVariables(
  local!clean: rule!SD_readTemplateStructure(document: todocument(55311)),
  local!v2: a!map(
    ok: true,
    headerLabels: index(local!clean, "headerLabels", {}),
    columns: {"Budget Category", "Initial Budget", "Revised Approved Budget", "Proposed Adjustments This Draw", "Proposed Budget", "Draw Funding This Period", "Total PTD inc. This Draw ($)", "Balance To Complete"},
    rows: remove(index(local!clean, "rows", {}), {14, 16})
  ),
  local!diff: rule!SD_diffTemplateStructure(baseline: local!clean, received: local!v2),
  a!map(
  A_good: a!localVariables(local!r: rule!SD_checkTemplateComparison(response: "OVERVIEW|The budget table in the new file is laid out differently from the last template that loaded, so its figures cannot be matched to the right columns and budget lines of the draw. The sender should restore the standard layout and resend the file." & char(10) & "CHANGE|COLUMN_RENAMED|Current Draw|Draw Funding This Period|The ""Current Draw"" column is now headed ""Draw Funding This Period""." & char(10) & "CHANGE|COLUMN_REMOVED|Total PTD inc. This Draw (%)||The ""Total PTD inc. This Draw (%)"" column has been removed." & char(10) & "CHANGE|ROW_REMOVED|Insurance||The ""Insurance"" budget line is missing." & char(10) & "CHANGE|ROW_REMOVED|Start-up/Marketing||The ""Start-up/Marketing"" budget line is missing.", success: true, errorMessage: null, aiAttempted: true, diff: local!diff, baselineLabel: "X"), a!map(ok: local!r.ok, aiUsed: local!r.aiUsed, failures: local!r.failures)),
  P_overviewWrongPart: a!localVariables(local!r: rule!SD_checkTemplateComparison(response: "OVERVIEW|The header fields and budget table columns in the new file are laid out differently from the last template that loaded, so its figures cannot be matched to the draw. The sender should restore the standard layout and resend the file." & char(10) & "CHANGE|COLUMN_RENAMED|Current Draw|Draw Funding This Period|The ""Current Draw"" column is now headed ""Draw Funding This Period""." & char(10) & "CHANGE|COLUMN_REMOVED|Total PTD inc. This Draw (%)||The ""Total PTD inc. This Draw (%)"" column has been removed." & char(10) & "CHANGE|ROW_REMOVED|Insurance||The ""Insurance"" budget line is missing." & char(10) & "CHANGE|ROW_REMOVED|Start-up/Marketing||The ""Start-up/Marketing"" budget line is missing.", success: true, errorMessage: null, aiAttempted: true, diff: local!diff, baselineLabel: "X"), a!map(ok: local!r.ok, aiUsed: local!r.aiUsed, failures: local!r.failures)),
  O_overviewRestates_live2: a!localVariables(local!r: rule!SD_checkTemplateComparison(response: "OVERVIEW|The new file differs from the last template that loaded in both the budget table columns and the budget category rows, which prevents the system from matching draw data to the correct positions in the workbook. A column has been renamed, a percentage column has been removed, a funding column has been renamed, and several budget lines are missing from the bottom of the category list." & char(10) & "CHANGE|COLUMN_RENAMED|Current Draw|Draw Funding This Period|The ""Current Draw"" column is now headed ""Draw Funding This Period""." & char(10) & "CHANGE|COLUMN_REMOVED|Total PTD inc. This Draw (%)||The ""Total PTD inc. This Draw (%)"" column has been removed." & char(10) & "CHANGE|ROW_REMOVED|Insurance||The ""Insurance"" budget line is missing." & char(10) & "CHANGE|ROW_REMOVED|Start-up/Marketing||The ""Start-up/Marketing"" budget line is missing.", success: true, errorMessage: null, aiAttempted: true, diff: local!diff, baselineLabel: "X"), a!map(ok: local!r.ok, aiUsed: local!r.aiUsed, failures: local!r.failures)),
  B_invented: a!localVariables(local!r: rule!SD_checkTemplateComparison(response: "OVERVIEW|The budget table in the new file is laid out differently from the last template that loaded, so its figures cannot be matched to the right columns and budget lines of the draw. The sender should restore the standard layout and resend the file." & char(10) & "CHANGE|COLUMN_RENAMED|Current Draw|Draw Funding This Period|The ""Current Draw"" column is now headed ""Draw Funding This Period""." & char(10) & "CHANGE|COLUMN_REMOVED|Total PTD inc. This Draw (%)||The ""Total PTD inc. This Draw (%)"" column has been removed." & char(10) & "CHANGE|ROW_REMOVED|Insurance||The ""Insurance"" budget line is missing." & char(10) & "CHANGE|ROW_REMOVED|Start-up/Marketing||The ""Start-up/Marketing"" budget line is missing." & char(10) & "CHANGE|ROW_REMOVED|Taxes||The ""Taxes"" line is missing.", success: true, errorMessage: null, aiAttempted: true, diff: local!diff, baselineLabel: "X"), a!map(ok: local!r.ok, aiUsed: local!r.aiUsed, failures: local!r.failures)),
