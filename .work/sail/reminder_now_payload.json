    "attended": false,
    "runAs": "DESIGNER"
   }
  },
  {
   "id": 4,
   "type": "internal.16",
   "name": "The waiting step (rules)",
   "coordinates": [
    320,
    200
   ],
   "connections": [
    {
     "targetNodeId": 5,
     "activityChained": false
    }
   ],
   "data": {
    "customOutputs": [
     {
      "expression": "tointeger(a!defaultValue(index(pv!state, \"currentStep\", null), null))",
      "saveInto": "pv!stepOrder"
     },
     {
      "expression": "and(a!defaultValue(index(pv!state, \"found\", false), false), tostring(a!defaultValue(index(pv!state, \"drawStatus\", \"\"), \"\")) = \"In Progress\", tostring(a!defaultValue(index(index(pv!state, \"current\", null), \"status\", \"\"), \"\")) = \"In Progress\", not(a!isNullOrEmpty(index(pv!state, \"currentStep\", null))))",
      "saveInto": "pv!canSend"
     },
     {
      "expression": "\"#\" & a!defaultValue(index(pv!state, \"drawNumber\", null), \"draw \" & pv!drawId)",
      "saveInto": "pv!drawLabel"
     },
     {
      "expression": "\"step \" & a!defaultValue(index(pv!state, \"currentStep\", \"?\"), \"?\") & \" \u00b7 \" & a!defaultValue(index(index(pv!state, \"current\", null), \"role\", \"\"), \"\")",
      "saveInto": "pv!stepLabel"
     }
    ]
   },
   "assignment": {
    "attended": false,
    "runAs": "DESIGNER"
   }
  },
  {
